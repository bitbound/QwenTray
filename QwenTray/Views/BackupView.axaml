<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QwenTray.ViewModels"
             xmlns:views="using:QwenTray.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="QwenTray.Views.BackupView"
             x:DataType="vm:BackupViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" Margin="20,20,20,0">
      <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">

        <TextBlock Classes="h1" Text="Backup" />

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="WSL backup" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="A folder carrying the virtual disk the distro boots from, together with this machine's QwenTray settings. An import protects those settings again for the account on the machine it lands on, so they travel unlocked and the bundle has to be kept somewhere private." />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Bundle folder" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBox Text="{Binding BundlePath}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="Export creates this folder and refuses to touch one that is already there. For an import, point it at a bundle folder made earlier." />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Export bundle"
                      Classes="Primary VariantFilled"
                      Command="{Binding ExportBundleCommand}"
                      IsEnabled="{Binding CanExportBundle}" />
              <Button Content="Import bundle"
                      Classes="Primary VariantOutlined"
                      Command="{Binding ImportBundleCommand}"
                      IsEnabled="{Binding CanImportBundle}" />
            </StackPanel>

            <TextBlock Classes="progress"
                       Text="{Binding BundleProgress}"
                       IsVisible="{Binding BundleProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Configuration backup" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="A ZIP of the files below, taken from the active profile's home inside the distro. The Windows .qwen folder is never read or written." />

            <TextBlock Classes="field" Text="Paths to include" />
            <TextBox Text="{Binding ConfigPaths}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     MaxHeight="200"
                     FontFamily="Consolas,Menlo,monospace" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="One absolute Linux path per line, for example /home/qwen/.qwen/QWEN.md. A folder includes every file under it." />

            <TextBlock Classes="field" Text="Archive file" Margin="0,6,0,0" />
            <TextBox Text="{Binding ConfigArchivePath}" Margin="0,6,0,0" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Export writes to this path and refuses to overwrite a file that is already there. For a restore, point it at an archive made earlier. settings.json holds live credentials, so keep the archive private." />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Export backup"
                      Classes="Primary VariantFilled"
                      Command="{Binding ExportConfigCommand}"
                      IsEnabled="{Binding CanArchiveConfig}" />
              <Button Content="Restore backup"
                      Classes="Primary VariantOutlined"
                      Command="{Binding RestoreConfigCommand}"
                      IsEnabled="{Binding CanArchiveConfig}" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <views:SettingsFooter Grid.Row="1" DataContext="{Binding Save}" />

  </Grid>
</UserControl>
