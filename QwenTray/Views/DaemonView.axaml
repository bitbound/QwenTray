<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QwenTray.ViewModels"
             xmlns:conv="using:QwenTray.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="QwenTray.Views.DaemonView"
             x:DataType="vm:DaemonViewModel">

  <UserControl.Resources>
    <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="PathIcon.state">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="PathIcon.state.running">
      <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>

    <Style Selector="PathIcon.state.starting">
      <Setter Property="Foreground" Value="{DynamicResource WarningColor}" />
    </Style>

    <Style Selector="PathIcon.state.crashed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style Selector="TextBlock.value">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Margin="20">
    <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">

      <TextBlock Classes="h1" Text="Daemon" />

      <Border Classes="Card">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Classes="state"
                      Classes.running="{Binding IsRunning}"
                      Classes.starting="{Binding IsStarting}"
                      Classes.crashed="{Binding IsCrashed}"
                      Data="{Binding StateIconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                      Width="24"
                      Height="24"
                      VerticalAlignment="Center" />
            <TextBlock Text="{Binding StateText}"
                       Classes="h2"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Classes="caption" Text="Endpoint" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding Endpoint}" />

            <TextBlock Grid.Row="1" Classes="caption" Text="Health check" Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Margin="0,8,0,0" Text="{Binding HealthUrl}" />

            <TextBlock Grid.Row="2" Classes="caption" Text="Process id" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Margin="0,8,0,0" Text="{Binding ProcessId}" />

            <TextBlock Grid.Row="3" Classes="caption" Text="Log file" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" Classes="value" Margin="0,8,0,0" Text="{Binding LogPath}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="Primary VariantFilled"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding CanStart}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource play_regular}" />
                <TextBlock Text="Start" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="Default VariantOutlined"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding CanStop}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource stop_regular}" />
                <TextBlock Text="Stop" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="Default VariantOutlined"
                    Command="{Binding RestartCommand}"
                    IsEnabled="{Binding CanRestart}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource arrow_sync_regular}" />
                <TextBlock Text="Restart" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     Text="Start adopts a daemon that is already answering on this endpoint instead of spawning a second one." />
        </StackPanel>
      </Border>

      <Border Classes="Card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="Web Shell" />

          <TextBlock Classes="value" Text="{Binding WebUrl}" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="Primary VariantOutlined"
                    Command="{Binding OpenWebShellCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource open_regular}" />
                <TextBlock Text="Open in browser" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Classes="Default VariantOutlined"
                    Command="{Binding OpenLogCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource open_regular}" />
                <TextBlock Text="Open daemon log" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>