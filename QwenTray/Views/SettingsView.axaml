<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:QwenTray.ViewModels"
             xmlns:conv="using:QwenTray.Converters"
             xmlns:local="using:QwenTray"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="900"
             x:Class="QwenTray.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Resources>
    <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Padding" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="Border.status">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.status.bad">
      <Setter Property="Background" Value="{DynamicResource SnackbarErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}" />
    </Style>
    <Style Selector="Border.status.good">
      <Setter Property="Background" Value="{DynamicResource SnackbarSuccessBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="Border.status.neutral">
      <Setter Property="Background" Value="{DynamicResource BackgroundGrayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>

    <Style Selector="TextBlock.statusTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.statusDetail">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.status.bad TextBlock.statusTitle">
      <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>
    <Style Selector="Border.status.good TextBlock.statusTitle">
      <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="Border.status.neutral TextBlock.statusTitle">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.status.bad PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>
    <Style Selector="Border.status.good PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
    </Style>
    <Style Selector="Border.status.neutral PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- Set apart from the actions above it, because these ones cannot be undone. -->
    <Style Selector="Border.DangerZone">
      <Setter Property="Background" Value="{DynamicResource SnackbarErrorBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style Selector="TextBlock.dangerHeading">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style Selector="TextBlock.progress">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" Margin="20,20,20,0">
      <StackPanel Spacing="16" MaxWidth="780" HorizontalAlignment="Left">

        <TextBlock Classes="h1" Text="Settings" />

        <Border Classes="Card">
          <StackPanel Spacing="12">
            <TextBlock Classes="h2" Text="Linux environment" />

            <Border Classes="status"
                    Classes.bad="{Binding DistroNeedsAttention}"
                    Classes.good="{Binding DistroIsReady}"
                    Classes.neutral="{Binding DistroIsChecking}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Width="28"
                          Height="28"
                          VerticalAlignment="Center"
                          Data="{Binding DistroStatusIconKey, Converter={StaticResource ResourceKeyToGeometryConverter}}" />
                <StackPanel Spacing="3">
                  <TextBlock Classes="statusTitle" Text="{Binding DistroBannerTitle}" TextWrapping="Wrap" />
                  <TextBlock Classes="statusDetail"
                             Text="{Binding DistroStatus}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding DistroStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="caption"
                             Text="{Binding DistroNextStep}"
                             TextWrapping="Wrap"
                             IsVisible="{Binding DistroNextStep, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="WSL distro" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBox Text="{Binding WslDistroName}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="QwenTray creates and owns this distro. Windows apps and drives are not available inside it." />
              </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="{Binding SetupDistroLabel}"
                      Classes="Primary VariantFilled"
                      Command="{Binding SetupDistroCommand}"
                      IsEnabled="{Binding CanSetupDistro}" />
              <Button Content="Check status"
                      Classes="Primary VariantOutlined"
                      Command="{Binding RefreshDistroCommand}"
                      IsEnabled="{Binding !IsDistroBusy}" />
            </StackPanel>

            <TextBlock Classes="caption"
                       Text="{Binding SetupDistroHelp}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="progress"
                       Text="{Binding DistroProgress}"
                       IsVisible="{Binding DistroProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Classes="DangerZone">
              <StackPanel Spacing="8">
                <TextBlock Classes="dangerHeading" Text="Delete and rebuild" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="Rebuild discards this distro and builds an empty one under the same name. Delete unregisters it and throws away its filesystem. Both take every profile's keys, GitHub sign-ins, workspaces, and Qwen configuration with them, and neither can be undone." />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Rebuild"
                          Classes="Error VariantOutlined"
                          Command="{Binding RebuildDistroCommand}"
                          IsEnabled="{Binding CanRebuildDistro}" />
                  <Button Content="Delete"
                          Classes="Error VariantFilled"
                          Command="{Binding DeleteDistroCommand}"
                          IsEnabled="{Binding CanDeleteDistro}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Developer tools" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="One-click installs that run inside the distro as root, so every identity profile shares them. Pressing a button again fetches the newest version and installs it over what is already there." />

            <ItemsControl ItemsSource="{Binding DevTools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DevToolRowViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="caption" Text="{Binding Summary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Install"
                            Classes="Primary VariantOutlined"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            Command="{Binding InstallCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="progress"
                       Text="{Binding ToolProgress}"
                       IsVisible="{Binding ToolProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Identity profiles" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Active profile" />
              <ComboBox Grid.Row="0" Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Profiles}"
                        SelectedItem="{Binding SelectedProfile}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="local:IdentityProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Grid.Row="1" Classes="field" Text="Profile name" Margin="0,10,0,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding ProfileName}" />

              <TextBlock Grid.Row="2" Classes="field" Text="Linux user" Margin="0,10,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Spacing="4">
                <TextBox Text="{Binding ProfileLinuxUser}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="The Linux user is this profile's identity. Its home holds the ssh key, gh token, git config, and Qwen Code settings." />
              </StackPanel>

              <TextBlock Grid.Row="3" Classes="field" Text="Signing key name" Margin="0,10,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Spacing="4">
                <TextBox Text="{Binding ProfileGpgName}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="The display name on the signing key. Defaults to QwenTray followed by the Linux user. Regenerate the key for a change to take effect." />
              </StackPanel>

              <TextBlock Grid.Row="4" Classes="field" Text="Signing key email" Margin="0,10,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Spacing="4">
                <TextBox Text="{Binding ProfileEmail}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="The email in the signing key's user id. Defaults to the Linux user at qwentray.local. Regenerate the key for a change to take effect." />
              </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Workspace directory" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ProfileWorkspace}" />
            </Grid>

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="New profile name" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewProfileName}" />

              <TextBlock Grid.Row="1" Classes="field" Text="New profile user" Margin="0,10,0,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding NewProfileUser}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Add profile" Classes="Primary VariantOutlined" Command="{Binding AddProfileCommand}" />
              <Button Content="Duplicate" Classes="Primary VariantOutlined" Command="{Binding DuplicateProfileCommand}" />
              <Button Content="Remove profile" Classes="Primary VariantOutlined" Command="{Binding RemoveProfileCommand}" />
            </StackPanel>

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Duplicate copies the name, user, and directory fields above into a new profile; leave them empty to get a copy with its own Linux user. Duplicating never copies keys or the GitHub sign-in, because that would be the same identity twice. Press Set up distro to create a new profile's Linux user. Saving with a different active profile restarts the daemon as that identity." />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Daemon" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Qwen executable" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <TextBox Text="{Binding QwenExecutable}"
                         ToolTip.Tip="Absolute Linux path to the Qwen launcher in the distro." />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="The daemon runs inside the WSL distro as the active profile's Linux user, so this is a Linux path." />
              </StackPanel>

              <TextBlock Grid.Row="1" Classes="field" Text="Hostname to bind" Margin="0,10,0,0" />
              <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Spacing="4">
                <TextBox Text="{Binding Host}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="The daemon's main address. 127.0.0.1 keeps it on this PC. A LAN address or 0.0.0.0 exposes it to the network and needs a token." />
              </StackPanel>

              <TextBlock Grid.Row="2" Classes="field" Text="Port" Margin="0,10,0,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding Port}" />
            </Grid>

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Installed version" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="field" Text="{Binding QwenVersion}" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Check for updates"
                      Classes="Primary VariantOutlined"
                      Command="{Binding CheckQwenUpdateCommand}"
                      IsEnabled="{Binding !IsQwenBusy}" />
              <Button Content="Update Qwen"
                      Classes="Primary VariantOutlined"
                      Command="{Binding UpdateQwenCommand}"
                      IsEnabled="{Binding !IsQwenBusy}" />
            </StackPanel>

            <TextBlock Classes="progress"
                       Text="{Binding QwenProgress}"
                       IsVisible="{Binding QwenProgress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Identity credentials" />

            <TextBlock Classes="field" Text="SSH public key" />
            <StackPanel Spacing="6">
              <TextBox Text="{Binding SshPublicKey}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="48"
                       FontFamily="Consolas,Menlo,monospace" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy public key"
                        Classes="Primary VariantOutlined"
                        Command="{Binding CopySshKeyCommand}"
                        IsEnabled="{Binding HasSshPublicKey}" />
                <Button Content="Generate key"
                        Classes="Primary VariantOutlined"
                        Command="{Binding GenerateSshKeyCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}"
                        IsVisible="{Binding !HasSshPublicKey}" />
                <Button Content="Regenerate"
                        Classes="Error VariantOutlined"
                        Command="{Binding RegenerateSshKeyCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}"
                        IsVisible="{Binding HasSshPublicKey}" />
                <Button Content="Delete"
                        Classes="Error VariantText"
                        Command="{Binding DeleteSshKeyCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}"
                        IsVisible="{Binding HasSshPublicKey}" />
                <Button Content="Refresh"
                        Classes="Default VariantText"
                        Command="{Binding LoadIdentityCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}" />
              </StackPanel>
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="No ssh key for this profile yet. Generate key creates one in its home directory."
                         IsVisible="{Binding !HasSshPublicKey}" />
            </StackPanel>

            <TextBlock Classes="field" Text="GPG public key" Margin="0,10,0,0" />
            <StackPanel Spacing="6">
              <TextBox Text="{Binding GpgPublicKey}"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="48"
                       FontFamily="Consolas,Menlo,monospace" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy public key"
                        Classes="Primary VariantOutlined"
                        Command="{Binding CopyGpgKeyCommand}"
                        IsEnabled="{Binding HasGpgPublicKey}" />
                <Button Content="Generate key"
                        Classes="Primary VariantOutlined"
                        Command="{Binding GenerateGpgKeyCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}"
                        IsVisible="{Binding !HasGpgPublicKey}" />
                <Button Content="Regenerate"
                        Classes="Error VariantOutlined"
                        Command="{Binding RegenerateGpgKeyCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}"
                        IsVisible="{Binding HasGpgPublicKey}" />
                <Button Content="Delete"
                        Classes="Error VariantText"
                        Command="{Binding DeleteGpgKeyCommand}"
                        IsEnabled="{Binding !IsIdentityBusy}"
                        IsVisible="{Binding HasGpgPublicKey}" />
              </StackPanel>
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="An ed25519 signing key with no passphrase, held in this profile's own keyring, so it can sign commits unattended." />
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="No signing key for this profile yet. Generate key creates one in its keyring."
                         IsVisible="{Binding !HasGpgPublicKey}" />
            </StackPanel>

            <TextBlock Classes="field" Text="GitHub token" Margin="0,10,0,0" />
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="GitHubTokenBox"
                         Text="{Binding GitHubToken}"
                         PasswordChar="&#x25CF;" />
                <ToggleButton Grid.Column="1"
                              Classes="Icon"
                              IsChecked="{Binding #GitHubTokenBox.RevealPassword}"
                              ToolTip.Tip="Show the token"
                              Margin="4,0,0,0">
                  <Panel>
                    <PathIcon Data="{StaticResource eye_off_regular}" />
                    <PathIcon Data="{StaticResource eye_show_regular}"
                              IsVisible="{Binding #GitHubTokenBox.RevealPassword}" />
                  </Panel>
                </ToggleButton>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save token"
                        Classes="Primary VariantFilled"
                        Command="{Binding SaveGitHubTokenCommand}"
                        IsEnabled="{Binding !IsGitHubBusy}" />
                <Button Content="Sign out"
                        Classes="Primary VariantOutlined"
                        Command="{Binding SignOutGitHubCommand}"
                        IsEnabled="{Binding !IsGitHubBusy}" />
              </StackPanel>
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding GitHubAccountText}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Configuration sync" />

            <TextBlock Classes="field" Text="Entries to sync" />
            <TextBox Text="{Binding SyncEntries}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     MaxHeight="200"
                     FontFamily="Consolas,Menlo,monospace" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="One entry per line, relative to ~/.qwen. settings.json and projects are never synced." />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Content="Push to distro"
                      Classes="Primary VariantOutlined"
                      Command="{Binding PushConfigCommand}"
                      IsEnabled="{Binding !IsSyncing}" />
              <Button Content="Pull from distro"
                      Classes="Primary VariantOutlined"
                      Command="{Binding PullConfigCommand}"
                      IsEnabled="{Binding !IsSyncing}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Security" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Bearer token" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox x:Name="TokenBox"
                           Text="{Binding Token}"
                           PasswordChar="&#x25CF;" />
                  <ToggleButton Grid.Column="1"
                                Classes="Icon"
                                IsChecked="{Binding #TokenBox.RevealPassword}"
                                ToolTip.Tip="Show the token"
                                Margin="4,0,0,0">
                    <Panel>
                      <PathIcon Data="{StaticResource eye_off_regular}" />
                      <PathIcon Data="{StaticResource eye_show_regular}"
                                IsVisible="{Binding #TokenBox.RevealPassword}" />
                    </Panel>
                  </ToggleButton>
                </Grid>
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="Leave empty for a loopback-only daemon. A non-loopback bind needs a token. With one set, Open Web Shell passes it to the page in the address fragment." />
              </StackPanel>

              <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                        Content="Require auth, including on /health (--require-auth)"
                        IsChecked="{Binding RequireAuth}" />

              <TextBlock Grid.Row="2" Classes="field" Text="Allowed origins" Margin="0,10,0,0" />
              <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Spacing="4">
                <TextBox Text="{Binding AllowedOrigins}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="52" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="One per line. Needed behind a TLS-terminating proxy." />
              </StackPanel>

              <TextBlock Grid.Row="3" Classes="field" Text="TLS cert path" Margin="0,10,0,0" />
              <TextBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0" Text="{Binding TlsCertPath}" />

              <TextBlock Grid.Row="4" Classes="field" Text="TLS key path" Margin="0,10,0,0" />
              <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,10,0,0" Spacing="4">
                <TextBox Text="{Binding TlsKeyPath}" />
                <TextBlock Classes="caption"
                           TextWrapping="Wrap"
                           Text="Set both or neither. Enables https for the daemon and health check." />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Capabilities" />

            <CheckBox Content="Enable the session shell (--enable-session-shell)"
                      IsChecked="{Binding EnableSessionShell}"
                      ToolTip.Tip="Lets a connected client run terminal commands in the workspace." />

            <CheckBox Content="Serve the Web Shell (--no-web disables it)"
                      IsChecked="{Binding ServeWeb}" />

            <StackPanel Spacing="6">
              <CheckBox Content="Enable Local Control for paired devices"
                        IsChecked="{Binding LocalControl}" />
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         Text="Pairs a phone over a separate private connection on one IPv4 interface. Keep the main address at 127.0.0.1, enable the Web Shell, then scan the QR code below. Do not combine with a LAN bind." />
              <Border Background="{DynamicResource SurfaceBrush}" Padding="12" CornerRadius="8"
                      IsVisible="{Binding HasLocalControlPairingQr}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="field" Text="Scan with a device on the same trusted network" />
                  <Image Source="{Binding LocalControlPairingQr}" Width="240" Height="240"
                         HorizontalAlignment="Left" Stretch="Uniform" />
                </StackPanel>
              </Border>
              <TextBlock Classes="caption"
                         TextWrapping="Wrap"
                         IsVisible="{Binding ShowLocalControlPairingPending}"
                         Text="No pairing QR yet. Start the daemon from the Daemon page, then check that Local Control is active." />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Limits" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Max sessions" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MaxSessions}" />

              <TextBlock Grid.Row="1" Classes="field" Text="Max connections" Margin="0,10,0,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Text="{Binding MaxConnections}" />

              <TextBlock Grid.Row="2" Classes="field" Text="Event ring size" Margin="0,10,0,0" />
              <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" Text="{Binding EventRingSize}" />
            </Grid>

            <CheckBox Content="Enable per-tier HTTP rate limiting (--rate-limit)"
                      IsChecked="{Binding RateLimit}" />

            <CheckBox Content="Debug logging (-d)"
                      IsChecked="{Binding DebugMode}" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Tray behaviour" />

            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto">
              <TextBlock Grid.Row="0" Classes="field" Text="Health poll seconds" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       Text="{Binding HealthPollSeconds}"
                       ToolTip.Tip="How often the tray checks the daemon. Clamped between 1 and 60." />

              <TextBlock Grid.Row="1" Classes="field" Text="Max backoff seconds" Margin="0,10,0,0" />
              <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                       Text="{Binding MaxBackoffSeconds}"
                       ToolTip.Tip="Ceiling for the delay between restart attempts after repeated crashes." />
            </Grid>

            <CheckBox Content="Restart the daemon automatically after it crashes"
                      IsChecked="{Binding AutoRestart}" />

            <CheckBox Content="Start QwenTray when I sign in to Windows"
                      IsChecked="{Binding StartOnLogin}" />
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Updates" />

            <CheckBox Content="Check for a new QwenTray release automatically every two days"
                      IsChecked="{Binding CheckForUpdates}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Check now"
                      Classes="Primary VariantOutlined"
                      Command="{Binding CheckForUpdatesNowCommand}"
                      IsEnabled="{Binding !IsCheckingForUpdates}" />
              <TextBlock Classes="caption"
                         Text="{Binding UpdateCheckStatus}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap"
                         IsVisible="{Binding UpdateCheckStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Publisher trust" />

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="QwenTray builds are signed with a self-signed Bitbound certificate. Add its public key to this user's store so signatures validate and Explorer shows Bitbound as the publisher." />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Trust Bitbound publisher"
                      Classes="Primary VariantOutlined"
                      Command="{Binding TrustPublisherCommand}"
                      IsEnabled="{Binding !IsTrustingPublisher}"
                      IsVisible="{Binding !IsPublisherTrusted}" />
              <TextBlock Text="Spinning up the certificate stores…"
                         Classes="caption"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsTrustingPublisher}" />
              <TextBlock Text="The Bitbound certificate is trusted for this user."
                         Classes="field"
                         VerticalAlignment="Center"
                         IsVisible="{Binding IsPublisherTrusted}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="Card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Advanced" />

            <TextBlock Classes="field" Text="Extra daemon arguments" />
            <TextBox Text="{Binding ExtraArgs}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="70"
                     MaxHeight="240"
                     FontFamily="Consolas,Menlo,monospace" />
            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="One argument per line, appended to the spawn command verbatim. Use this for flags this page does not surface." />

            <TextBlock Classes="h2" Text="Diagnostics" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Open daemon log"
                      Classes="Primary VariantOutlined"
                      Command="{Binding OpenLogFileCommand}" />
              <Button Content="Open QwenTray folder"
                      Classes="Primary VariantOutlined"
                      Command="{Binding OpenTrayFolderCommand}"
                      ToolTip.Tip="The Windows folder holding this tray's own log and settings.json." />
            </StackPanel>

            <TextBlock Text="{Binding LogFilePath}" Classes="caption" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SettingsFilePath}" Classes="caption" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1" Classes="Footer">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="Save"
                Classes="Primary VariantFilled"
                Command="{Binding SaveCommand}" />

        <TextBlock Text="{Binding SaveError}"
                   Classes="Error"
                   MaxWidth="420"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <TextBlock Text="{Binding SaveMessage}"
                   Classes="Success"
                   Opacity="{Binding SaveMessageOpacity}"
                   VerticalAlignment="Center">
          <TextBlock.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.3" />
            </Transitions>
          </TextBlock.Transitions>
        </TextBlock>
        <TextBlock Text="{Binding SaveWarning}"
                   Classes="Warning"
                   MaxWidth="420"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
